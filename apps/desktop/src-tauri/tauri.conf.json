{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoLingo",
  "version": "0.2.0",
  "identifier": "app.echolingo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EchoLingo",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "caption",
        "title": "EchoLingo Caption",
        "url": "index.html?window=caption",
        "width": 860,
        "height": 228,
        "minWidth": 460,
        "minHeight": 130,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": true,
        "transparent": false
      }
    ],
    "security": {"csp": null}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/echolingo-sidecar"],
    "resources": ["runtimes/llama.cpp/"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
